<?xml version="1.0" encoding="utf-8"?>
<!-- map of all screens and how they connect. The Dashboard is the home screen. -->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/dashboardFragment">

    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.example.realestateandpropertymanagementsystem.ui.DashboardFragment"
        android:label="@string/app_name">
        <action
            android:id="@+id/action_dashboardFragment_to_tenantListFragment"
            app:destination="@id/tenantListFragment" />
        <action
            android:id="@+id/action_dashboardFragment_to_addTenantFragment"
            app:destination="@id/addTenantFragment" />
    </fragment>

    <fragment
        android:id="@+id/tenantListFragment"
        android:name="com.example.realestateandpropertymanagementsystem.ui.TenantListFragment"
        android:label="@string/tenants_title">
        <action
            android:id="@+id/action_tenantListFragment_to_addTenantFragment"
            app:destination="@id/addTenantFragment" />
        <action
            android:id="@+id/action_tenantListFragment_to_tenantDetailsFragment"
            app:destination="@id/tenantDetailsFragment" />
    </fragment>

    <fragment
        android:id="@+id/tenantDetailsFragment"
        android:name="com.example.realestateandpropertymanagementsystem.ui.TenantDetailsFragment"
        android:label="@string/tenant_details">
        <argument
            android:name="tenantId"
            android:defaultValue="-1"
            app:argType="integer" />
        <action
            android:id="@+id/action_tenantDetailsFragment_to_addTenantFragment"
            app:destination="@id/addTenantFragment" />
    </fragment>

    <fragment
        android:id="@+id/addTenantFragment"
        android:name="com.example.realestateandpropertymanagementsystem.ui.AddTenantFragment"
        android:label="@string/add_tenant">
        <argument
            android:name="tenantId"
            android:defaultValue="-1"
            app:argType="integer" />
    </fragment>
</navigation>