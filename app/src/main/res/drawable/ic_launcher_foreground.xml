<?xml version="1.0" encoding="utf-8"?>
<!-- App icon foreground: a house with a key beside it, as if opening it.
     The icon canvas is 108x108; the safe area is the middle 66x66. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

  <!-- House: roof + walls, with the door cut out (evenOdd makes the second shape a hole) -->
  <path
      android:fillColor="#FFFFFF"
      android:fillType="evenOdd"
      android:pathData="M46,36 L70,57 L62,57 L62,78 L30,78 L30,57 L22,57 Z M42,78 L42,64 L50,64 L50,78 Z" />

  <!-- Key, drawn horizontally around the point (0,0), then moved to the lower right
       and rotated 225 degrees so the shaft points up-left towards the house.
       Change android:rotation to tilt it differently. -->
  <group
      android:pivotX="0"
      android:pivotY="0"
      android:rotation="225"
      android:translateX="80"
      android:translateY="80">
    <!-- Key head: a ring -->
    <path
        android:fillColor="#F2C94C"
        android:fillType="evenOdd"
        android:pathData="M-9,0 a9,9 0 1,0 18,0 a9,9 0 1,0 -18,0 Z M-4,0 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0 Z" />
    <!-- Key shaft -->
    <path
        android:fillColor="#F2C94C"
        android:pathData="M8,-2.5 L26,-2.5 L26,2.5 L8,2.5 Z" />
    <!-- Key teeth -->
    <path
        android:fillColor="#F2C94C"
        android:pathData="M19,2.5 L19,7 L22,7 L22,2.5 Z M23,2.5 L23,5.5 L26,5.5 L26,2.5 Z" />
  </group>
</vector>
