<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded card with a navy-to-blue gradient, used as the dashboard header.
     angle 270 = top to bottom. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="@color/brand_toolbar"
        android:endColor="@color/brand_header_end" />
    <corners android:radius="20dp" />
</shape>